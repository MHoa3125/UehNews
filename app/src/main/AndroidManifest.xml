<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UehNews"
        tools:targetApi="31">

        <!-- MainActivity là màn hình khởi chạy -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <!-- Admin Activities -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.ManageAuthorsActivity"
            android:exported="false"
            android:label="Quản lý tài khoản Tác giả"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"/>

        <activity
            android:name=".ui.admin.ArticleApprovalActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"/>

        <!-- SỬA LỖI: Thêm khai báo cho màn hình xem trước của Admin -->
        <activity
            android:name=".ui.admin.AdminPreviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.ArticleApprovalActivity"/>

        <activity
            android:name=".ui.admin.ManageCategoriesActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"
            android:label="Quản lý danh mục" />

        <!-- Mới thêm: Màn hình danh sách bài viết theo danh mục -->
        <activity
            android:name=".ui.categories.CategoryArticlesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>

        <!-- Author Activities -->
        <activity
            android:name=".ui.author.AuthorDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.author.WriteArticleActivity"
            android:exported="false"
            android:parentActivityName=".ui.author.AuthorDashboardActivity"/>

        <activity
            android:name=".ui.author.PreviewArticleActivity"
            android:exported="false"
            android:parentActivityName=".ui.author.WriteArticleActivity"/>

        <activity
            android:name=".ui.author.MyArticlesActivity"
            android:exported="false"
            android:parentActivityName=".ui.author.AuthorDashboardActivity"/>

        <!-- Common/Guest Activities -->
        <activity
            android:name=".ui.activities.ArticleDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.activities.ArticleSearchActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.activities.FavoritesActivity"
            android:exported="false"
            android:label="Bài viết yêu thích"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.activities.HistoryActivity"
            android:exported="false"
            android:label="Lịch sử đã xem"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
