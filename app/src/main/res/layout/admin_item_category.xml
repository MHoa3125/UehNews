<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/ueh_blue_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Tên danh mục (ID được giữ nguyên) -->
        <TextView
            android:id="@+id/tv_category_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ueh_blue_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Thêm danh mục" />

        <!-- Nút Sửa (ID được giữ nguyên) -->
        <ImageButton
            android:id="@+id/btn_edit_category"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sửa danh mục"
            android:src="@drawable/ic_edit"
            app:tint="@color/ueh_blue" />

        <!-- Nút Xóa (ID được giữ nguyên) -->
        <ImageButton
            android:id="@+id/btn_delete_category"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa danh mục"
            android:src="@drawable/ic_delete"
            app:tint="@color/ueh_orange" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
