<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp"
    tools:context=".ui.profile.ProfileFragment">

    <!-- Tiêu đề của trang -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:text="Cá Nhân"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Khối chức năng cho người đọc (Guest) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/rounded_container_background"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Nút Tin đã lưu -->
        <TextView
            android:id="@+id/btn_saved_articles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="16dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="Tin đã lưu"
            android:textSize="18sp"
            app:drawableStartCompat="@drawable/ic_bookmark_border" /> <!-- SỬA 1: Dùng ic_bookmark_border -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#E0E0E0" />

        <!-- Nút Tin đọc gần đây -->
        <TextView
            android:id="@+id/btn_recent_articles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="16dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="Tin đọc gần đây"
            android:textSize="18sp"
            app:drawableStartCompat="@drawable/ic_history" /> <!-- GIỮ NGUYÊN: Bạn đã có file này -->
    </LinearLayout>

    <!-- Khoảng trống để đẩy phần đăng nhập xuống dưới -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Khối đăng nhập cho Admin/Author -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Bạn là Tác giả hoặc Quản trị viên?" />

        <Button
            android:id="@+id/btn_go_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng nhập tại đây" />
    </LinearLayout>

</LinearLayout>
