<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="top"
    tools:context=".ui.admin.AdminDashboardActivity">

    <TextView
        android:id="@+id/tv_admin_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TRANG QUẢN TRỊ VIÊN"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_manage_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quản lý Danh mục"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_manage_accounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quản lý Tài khoản"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_review_articles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Duyệt bài viết"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- SỬA LỖI: Thêm id chính xác cho Button đăng xuất -->
    <Button
        android:id="@+id/btn_admin_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Đăng xuất"/>

</LinearLayout>
