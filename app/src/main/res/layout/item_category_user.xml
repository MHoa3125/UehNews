<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Thiết kế lại item danh mục để "UEH-hóa" và an toàn:
  - Bỏ ImageView không sử dụng để giao diện gọn gàng hơn.
  - Biến CardView thành một thẻ màu, chỉ chứa văn bản.
  - Dùng màu xanh dương đặc trưng của UEH làm nền và chữ trắng để nổi bật.
  - Tăng bo góc và độ cao cố định để các item đồng đều và hiện đại.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="90dp" 
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/ueh_blue"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <TextView
        android:id="@+id/tv_category_name_user"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="Tên Danh Mục"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

</androidx.cardview.widget.CardView>
